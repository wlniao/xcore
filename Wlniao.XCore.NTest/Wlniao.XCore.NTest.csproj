<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />

    <!--
      仅测试项目保留 BouncyCastle，作为 SM2/SM3/RSA 改造的参照实现。
      Wlniao.XCore 本身已不再依赖它；这里引用是为了让 SM2InteropTests 能做
      "XCore 产出 → BC 消费 / BC 产出 → XCore 消费" 的双向互操作校验，
      从而把 "改造前后结果一致" 变成每次 dotnet test 都会执行的断言，而非一次性人工比对。
    -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <!--
    本工程自身占用了 Wlniao.XCore 命名空间（namespace Wlniao.XCore.NTest），
    导致源码里写 Wlniao.XCore.Xxx 时编译器会优先解析成命名空间而不是同名类型 XCore（CS0435/CS0234）。
    为被测程序集额外注册一个外部别名 xcore，需要访问 Wlniao.XCore 类型的测试文件里写：
        extern alias xcore;   →   xcore::Wlniao.XCore.AcceptAnyServerCertificate
    global 必须一并保留，否则其余按常规方式引用 XCore 类型的测试文件会全部编译失败。
  -->
  <ItemGroup>
    <ProjectReference Include="..\Wlniao.XCore\Wlniao.XCore.csproj" Aliases="global,xcore" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
